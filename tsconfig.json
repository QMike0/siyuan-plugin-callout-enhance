{
  "compilerOptions": {
    "target": "es6",
    "lib": ["ES2017", "DOM"],
    "module": "commonjs",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["siyuan"]
  },
  "include": ["src/**/*"]
}
